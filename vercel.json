{
  "redirects": [
    {
      "source": "/:path((?!sitemap\\.xml|robots\\.txt|llms\\.txt|humans\\.txt|manifest\\.json|favicon\\.svg|bestastrology\\.png|images|assets|fonts|videos).*)",
      "has": [{ "type": "host", "value": "mpshastriastrology.com" }],
      "destination": "https://www.mpshastriastrology.com/:path",
      "permanent": true
    },
    {
      "source": "/AstrologyServices",
      "destination": "/astrologyservices",
      "permanent": true
    },
    {
      "source": "/astrology-services",
      "destination": "/astrologyservices",
      "permanent": true
    },
    {
      "source": "/Face-reading",
      "destination": "/face-reading",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/images/opt/MPShastriLogo-192w.webp",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
